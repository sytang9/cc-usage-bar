#!/usr/bin/env bash
# ccswitch: save, list, switch between, and delete Claude Code accounts by
# swapping the OAuth credential files Claude Code reads from $HOME.
#
# Storage layout:
#   $HOME/.claude/accounts/<label>/credentials.json   (copy of live .credentials.json)
#   $HOME/.claude/accounts/<label>/oauthAccount.json  (the .oauthAccount object from .claude.json)
#
# SECURITY: never print token values or credential file contents. All moves
# use cp/jq, never echo of secret fields.

# Bumped by hand. ccswitch is copied into ~/.claude by install.sh, so an
# installed copy cannot be traced back to the checkout it came from -- this is
# the only way to ask one what it is.
CCSWITCH_VERSION="1.0.0"

set -uo pipefail

: "${HOME:?HOME must be set}"

CLAUDE_DIR="$HOME/.claude"
CLAUDE_JSON="$HOME/.claude.json"
CREDENTIALS_FILE="$CLAUDE_DIR/.credentials.json"
ACCOUNTS_DIR="$CLAUDE_DIR/accounts"

# Scratch dir for files that must NEVER outlive this process: the curl --config
# file (bearer token) and the refresh POST body (refresh token). Both are
# written to disk only to keep the secret out of argv, where /proc/<pid>/cmdline
# would expose it; leaking them to $TMPDIR instead just trades one exposure for
# a longer-lived one.
#
# Files that get RENAMED into place do NOT belong here -- they go in the
# destination's own directory via jq_write/file_write, so the rename is atomic.
CCSWITCH_TMPDIR="$(mktemp -d "${TMPDIR:-/tmp}/ccswitch.XXXXXX")" || {
  echo "Error: failed to create ccswitch's scratch temp directory (mktemp -d failed)." >&2
  exit 1
}
if ! chmod 700 "$CCSWITCH_TMPDIR"; then
  echo "Error: failed to secure ccswitch's scratch temp directory $CCSWITCH_TMPDIR (chmod 700 failed)." >&2
  exit 1
fi

# EXIT covers normal returns and every `exit 1` path; INT/TERM cover Ctrl-C and
# kill during a network call, which is the case that used to leak.
#
# Two things to know before touching this:
#  - bash does NOT run an EXIT trap when a command-substitution subshell
#    finishes, so the many `$(...)` calls in this script cannot delete the dir
#    out from under the run. (Verified; do not add a PID guard, which would
#    need BASHPID and break bash 3.2 on macOS.)
#  - `exec` does NOT fire EXIT, so cmd_switch calls cleanup_tmpdir explicitly
#    before its exec.
cleanup_tmpdir() {
  rm -rf "$CCSWITCH_TMPDIR"
}
trap 'cleanup_tmpdir' EXIT
trap 'cleanup_tmpdir; exit 130' INT
trap 'cleanup_tmpdir; exit 143' TERM

# --- `usage` subcommand: OAuth endpoint constants ---------------------------
# Reverse-engineered from third-party community projects (Anthropic does not
# publish this API). Sources checked 2026-07-19:
#   - github.com/pcvelz/ccstatusline-usage, src/utils/usage-fetch.ts and
#     usage-types.ts (fetched directly via `gh api .../contents/...`) --
#     CONFIRMED the usage URL, method, headers, and full response schema
#     (five_hour/seven_day buckets with utilization + resets_at).
#   - gist.github.com/jtbr/4f99671d1cee06b44106456958caba8b ("Claude Code
#     Status Line" guide) -- independently corroborates the same usage
#     endpoint/schema with a worked JSON example.
#   - flopsstuff.github.io/coqu/claude-oauth/ -- corroborates the token
#     endpoint host (platform.claude.com) and client_id.
#   - Community write-ups referencing RavenStorm-bit/claude-token-refresh and
#     an "Unlock Claude API from Claude Pro/Max" blog post -- corroborate the
#     refresh request body shape (grant_type/refresh_token/client_id) and a
#     snake_case response (access_token/expires_in/refresh_token).
#
# UNCERTAIN (best-supported guess, not directly observed in source): the
# refresh endpoint HOST. Anthropic is reported to have migrated OAuth token
# handling from console.anthropic.com to platform.claude.com; some
# community tools still hit console.anthropic.com/v1/oauth/token as a
# fallback. We pick platform.claude.com/v1/oauth/token as primary. If Claude
# Code accounts start showing "re-login" after a real (non-test) run, check
# this constant first -- it is the single most likely thing to have moved.
USAGE_API_URL="https://api.anthropic.com/api/oauth/usage"
USAGE_API_BETA_HEADER="oauth-2025-04-20"
TOKEN_REFRESH_URL="https://platform.claude.com/v1/oauth/token"
OAUTH_CLIENT_ID="9d1c250a-e61b-44d9-88ed-5944d1962f5e"
# The token-refresh endpoint sits behind Cloudflare, which fingerprints the
# HTTP client (TLS/HTTP-2 signature) and blocks a headless `curl` with a 429 --
# no header spoofing defeats that. Claude Code refreshes fine because it is a
# Node app, and Node's HTTP client passes. So we make the refresh POST via Node
# too (see refresh_token). `curl` is still used for the usage GET, whose host
# (api.anthropic.com) is not behind that WAF.
# The token-refresh endpoint rate-limits (429) if refreshed too often. When we
# hit one, back off for this long and skip further refresh attempts (a burst of
# expired accounts must not hammer it) -- the row shows a transient state, NOT
# a false re-login.
REFRESH_BACKOFF_SECONDS=300

USAGE_CACHE_TTL_SECONDS=600
USAGE_RATE_LIMIT_BACKOFF_SECONDS=120
USAGE_METER_WIDTH=12

# Max concurrent usage GETs. The GET endpoint (api.anthropic.com) is not the
# rate-limited one -- that is the token endpoint, which is refreshed serially --
# but firing 20 requests at once for a 20-account setup invites a 429 for no
# latency gain worth having.
USAGE_MAX_PARALLEL=4

# Treat a token as expired this many seconds BEFORE its stated expiry. Without
# a margin, a token with seconds left counts as valid, the usage GET 401s, and
# the 401-retry path pays a second round trip to recover what one proactive
# refresh would have handled.
TOKEN_EXPIRY_SKEW_SECONDS=60

# Wall-clock ceiling on one refresh POST. Without it a hung connection holds
# the refresh in flight indefinitely, and every second in flight is a second in
# which the outcome is unknown -- see attempt_refresh's in-flight marker.
REFRESH_TIMEOUT_SECONDS=20

# Set from cmd_usage's --refresh flag. Defaulted here because fetch_row_usage
# reads it and `set -u` turns an unset read into a hard exit -- a trap for any
# future caller that reaches fetch_row_usage without going through cmd_usage.
USAGE_BYPASS_CACHE=0

RESERVED_WORDS=(save delete list usage help version refresh-pause refresh-resume)
# Whitelist charset for labels. Deliberately strict: this is what stands
# between a label and a raw filesystem path ($ACCOUNTS_DIR/$label), so it
# must reject '/' and '.' outright rather than trying to blocklist "..".
LABEL_CHARSET_PATTERN='^[A-Za-z0-9_-]+$'

# is_dash_prefixed_label <label>: true if the label starts with '-' (would
# read as a CLI flag rather than a label). NOTE: '-' is itself inside
# LABEL_CHARSET_PATTERN's allowed set (for mid-label hyphens like
# "my-label"), so this leading-dash rule has to be enforced separately from
# the charset check below -- the charset regex alone would accept "-foo".
is_dash_prefixed_label() {
  case "$1" in
    -*) return 0 ;;
    *) return 1 ;;
  esac
}

# is_reserved_label <label>: true if the label collides with a reserved
# subcommand name.
is_reserved_label() {
  local label="$1" reserved
  for reserved in "${RESERVED_WORDS[@]}"; do
    [[ "$label" == "$reserved" ]] && return 0
  done
  return 1
}

# validate_label <label>: exits with a clear message and non-zero status
# unless the label is non-empty, made up only of [A-Za-z0-9_-], not
# dash-prefixed, and not a reserved subcommand name. Every code path that
# turns a label into a filesystem path (save/switch/delete) MUST call this
# before touching $ACCOUNTS_DIR/$label -- that path is built by direct
# string concatenation, so an unvalidated label (e.g. "../../etc") is a
# path-traversal vector into mkdir/cp/rm -rf.
validate_label() {
  local label="$1"
  if [[ -z "$label" ]]; then
    echo "Error: label is required." >&2
    exit 1
  fi
  if is_dash_prefixed_label "$label"; then
    echo "Error: '$label' looks like an option flag and cannot be used as a label." >&2
    exit 1
  fi
  if ! [[ "$label" =~ $LABEL_CHARSET_PATTERN ]]; then
    echo "Error: '$label' is not a valid label -- only letters, digits, '_' and '-' are allowed." >&2
    exit 1
  fi
  if is_reserved_label "$label"; then
    echo "Error: '$label' is a reserved word and cannot be used as a label." >&2
    exit 1
  fi
}

require_claude_json() {
  if [[ ! -f "$CLAUDE_JSON" ]]; then
    echo "Error: $CLAUDE_JSON not found." >&2
    exit 1
  fi
  if ! jq empty "$CLAUDE_JSON" >/dev/null 2>&1; then
    echo "Error: $CLAUDE_JSON is not valid JSON." >&2
    exit 1
  fi
}

require_live_credentials() {
  if [[ ! -f "$CREDENTIALS_FILE" ]]; then
    echo "Error: no active credentials found at $CREDENTIALS_FILE." >&2
    exit 1
  fi
}

# is_valid_json_object_file <path>: true iff the file is non-empty AND its
# top-level JSON value is an object. `jq empty` alone is NOT enough for this --
# it exits 0 on a zero-byte file ("zero JSON documents" is valid JSON to jq),
# so a bare `jq empty` check lets a 0-byte snapshot sail through. That matters
# here specifically because the OLD unchecked `cmd_save` wrote
# `jq '.oauthAccount // {}' >"$tmp"` with no status check, so a failed,
# killed, or disk-full save produced exactly a 0-byte oauthAccount.json --
# corruption that is already sitting in real users' ~/.claude/accounts/*.
is_valid_json_object_file() {
  local f="$1"
  [[ -s "$f" ]] && jq -e 'type == "object"' "$f" >/dev/null 2>&1
}

# secure_dir <path>: create a directory (if missing) and force mode 700.
secure_dir() {
  local dir="$1"
  mkdir -p "$dir"
  chmod 700 "$dir"
}

# secure_copy <src> <dst>: copy a file and force mode 600 on the destination.
# Returns non-zero, WITHOUT attempting the chmod, if the cp itself fails --
# `cp ...; chmod ...` would return chmod's status instead, which can mask a
# failed cp whenever <dst> already existed (chmod succeeds on the old file,
# reporting success even though nothing was actually copied).
secure_copy() {
  local src="$1" dst="$2"
  cp "$src" "$dst" || return 1
  chmod 600 "$dst"
}

# jq_write <dest> <jq-arg>...: run jq with the given args and replace <dest>
# with its output ONLY if jq exited 0 AND produced something. Returns non-zero,
# leaving <dest> untouched, otherwise. Destination ends up mode 600.
#
# NOTE: "produced something" is a non-empty-file check, not a shape check --
# a bare `null` (4 bytes) satisfies it. No current caller emits bare `null`,
# but a caller that must reject it (e.g. one writing a JSON object) has to
# assert the type itself, such as with `jq -e 'type == "object"'` on the result.
#
# Why this exists: `jq ... >"$tmp"; mv "$tmp" "$dest"` replaces the destination
# with an EMPTY file whenever jq fails -- a corrupt snapshot, a full disk, a
# killed process. That is how a truncated oauthAccount.json used to zero out
# ~/.claude.json while ccswitch still printed "Switched to ...". Never write a
# JSON file any other way.
#
# The temp file goes in the DESTINATION's own directory, not $TMPDIR, so the
# final mv is a same-filesystem rename and therefore atomic. $TMPDIR is a
# separate tmpfs on many systems, which silently degrades mv to a non-atomic
# copy+unlink -- a crash mid-copy leaves a half-written credential file.
# Scratch files that are NEVER renamed into place do not belong here; they go
# in $CCSWITCH_TMPDIR (see the trap block).
jq_write() {
  local dest="$1"
  shift
  local dest_dir tmp
  dest_dir="$(dirname "$dest")"
  tmp="$(mktemp "$dest_dir/.ccswitch-write.XXXXXX")" || return 1
  chmod 600 "$tmp"
  if jq "$@" >"$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then
    mv "$tmp" "$dest" && return 0
  fi
  rm -f "$tmp"
  return 1
}

# file_write <dest> <content>: same atomic-replace guarantee as jq_write for
# content that is already built (no jq run). Refuses to write empty content.
file_write() {
  local dest="$1" content="$2"
  [[ -n "$content" ]] || return 1
  local tmp
  tmp="$(mktemp "$(dirname "$dest")/.ccswitch-write.XXXXXX")" || return 1
  chmod 600 "$tmp"
  if printf '%s' "$content" >"$tmp" && [[ -s "$tmp" ]]; then
    mv "$tmp" "$dest" && return 0
  fi
  rm -f "$tmp"
  return 1
}

# install_credentials <snapshot> <dst>: write the snapshot's credentials to dst,
# but carry the LIVE mcpOAuth grants forward.
#
# .credentials.json holds two unrelated things: claudeAiOauth (which Claude
# account you are) and mcpOAuth/<server> (OAuth grants for MCP servers such as
# Atlassian). Switching Claude accounts must swap the first and must NOT discard
# the second — the MCP grant belongs to the human and the machine, not to the
# Claude account, so overwriting wholesale silently logs you out of every MCP
# server every time you switch. Per-server, the live grant wins; snapshot grants
# survive for servers the live file does not have.
install_credentials() {
  local snapshot="$1" dst="$2"

  # Both fallback branches below return secure_copy's OWN exit status rather
  # than a hardcoded 0: secure_copy propagates a failed `cp` (see its
  # definition), and its caller (cmd_switch) now checks this function's
  # status and aborts rather than reporting "Switched to ..." over a
  # credential write that never happened.
  if [[ ! -f "$dst" ]] || ! command -v jq >/dev/null 2>&1; then
    secure_copy "$snapshot" "$dst"
    return $?
  fi

  if jq_write "$dst" -s '.[0] as $snap | .[1] as $live
            | $snap
            + (if ($live.mcpOAuth // {}) == {} then {}
               else {mcpOAuth: (($snap.mcpOAuth // {}) + $live.mcpOAuth)} end)' \
       "$snapshot" "$dst"; then
    return 0
  fi
  secure_copy "$snapshot" "$dst"
  return $?
}

# Active-account identity is anchored on accountUuid, NOT refreshToken.
# refreshToken rotates on every use (the usage monitor's token-refresh flow
# writes a new one back after each successful refresh) so it cannot be a
# stable identity key; accountUuid never changes for a given account.
live_account_uuid() {
  jq -r '.oauthAccount.accountUuid // empty' "$CLAUDE_JSON" 2>/dev/null
}

saved_account_uuid() {
  local label="$1"
  jq -r '.accountUuid // empty' "$ACCOUNTS_DIR/$label/oauthAccount.json" 2>/dev/null
}

# saved_labels: print one label per line for every saved account, nothing at
# all when there are none. GUARANTEE: every label printed matches
# LABEL_CHARSET_PATTERN ([A-Za-z0-9_-]) -- this is what makes the unquoted
# `for label in $(saved_labels)` consumption below safe by construction, not
# by assumption about how directories got there.
#
# This is the ONLY sanctioned way to enumerate accounts. Three traps it
# closes: emptiness cannot be tested with `ls -A`, because ccswitch keeps its
# own dot-files (.no-refresh, .refresh-backoff) beside the account
# directories; an unmatched `*/` glob is not empty in bash -- without a -d
# guard the literal pattern reaches basename and renders as an account named
# '*'; and a directory `ccswitch save` did NOT create can hold whitespace or
# a glob character that `validate_label` would have rejected -- the charset
# check below is what keeps such a directory from being enumerated at all.
saved_labels() {
  local label_dir
  [[ -d "$ACCOUNTS_DIR" ]] || return 0
  for label_dir in "$ACCOUNTS_DIR"/*/; do
    [[ -d "$label_dir" ]] || continue
    [[ "$(basename "$label_dir")" =~ $LABEL_CHARSET_PATTERN ]] || continue
    basename "$label_dir"
  done
}

# mirror_live_to_snapshot: keep the ACTIVE account's saved snapshot in sync with
# the live credential file. Claude Code rotates the active account's refresh
# token inside $CREDENTIALS_FILE on its own schedule (single-use rotation),
# which silently invalidates the refresh token frozen in that account's saved
# snapshot. While the account stays active the staleness is masked (usage reads
# the live access token); it only surfaces as a FALSE "re-login" once you switch
# away and the account falls back to its now-dead snapshot. Mirroring
# live -> the matching snapshot (on every `usage` poll and before every switch)
# keeps the snapshot's tokens current, so switching away never strands an
# account. One-way only (live -> snapshot); it never writes the live file, so it
# cannot disturb the running Claude Code that owns it.
mirror_live_to_snapshot() {
  [[ -f "$CLAUDE_JSON" ]] || return 0
  [[ -f "$CREDENTIALS_FILE" ]] || return 0
  [[ -d "$ACCOUNTS_DIR" ]] || return 0

  # Mirror only a live file that still HOLDS a refresh token. Claude Code
  # blanks $CREDENTIALS_FILE when a grant is revoked or the user logs out --
  # accessToken "", refreshToken "", expiresAt 0. Copying that over a good
  # snapshot is not a staleness problem, it is destruction: that account's last
  # working refresh token is gone, so it can no longer be switched back to and
  # refreshed, only re-authenticated from scratch. The copy below is one-way
  # and has no undo, so the emptiness check has to happen HERE, ahead of it.
  #
  # Note the asymmetry with the rest of this file: everywhere else an empty
  # token is a thing to report, here it is a thing to refuse to propagate.
  is_valid_json_object_file "$CREDENTIALS_FILE" || return 0
  [[ -n "$(jq -r '.claudeAiOauth.refreshToken // empty' "$CREDENTIALS_FILE" 2>/dev/null)" ]] || return 0
  local live_uuid
  live_uuid="$(live_account_uuid)"
  [[ -n "$live_uuid" ]] || return 0
  local label
  # Unquoted $(saved_labels) is safe: see saved_labels' GUARANTEE.
  for label in $(saved_labels); do
    if [[ "$(saved_account_uuid "$label")" == "$live_uuid" ]]; then
      # `return 0` is unconditional here (not `secure_copy`'s status) --
      # already true before secure_copy started propagating cp failures, so
      # that change does not alter what this function returns.
      secure_copy "$CREDENTIALS_FILE" "$ACCOUNTS_DIR/$label/credentials.json"
      return 0
    fi
  done
}

confirm() {
  local prompt="$1" answer
  read -r -p "$prompt [y/N] " answer
  case "$answer" in
    y | Y | yes | YES) return 0 ;;
    *) return 1 ;;
  esac
}

cmd_save() {
  local label="${1:-}"

  validate_label "$label"

  require_claude_json
  require_live_credentials

  secure_dir "$ACCOUNTS_DIR"

  local label_dir="$ACCOUNTS_DIR/$label"
  if [[ -d "$label_dir" ]]; then
    if ! confirm "Account '$label' already exists. Overwrite?"; then
      echo "Aborted."
      exit 0
    fi
  fi
  secure_dir "$label_dir"

  if ! secure_copy "$CREDENTIALS_FILE" "$label_dir/credentials.json"; then
    # Do not leave a partial/stale credentials.json behind: on an OVERWRITE
    # save, a failed cp can leave the PREVIOUS account's credentials (or a
    # truncated file) sitting where the switch pre-flight looks for the NEW
    # account's snapshot. Removing it here means a present-but-broken copy
    # cannot masquerade as a healthy save.
    rm -f "$label_dir/credentials.json"
    echo "Error: failed to write $label_dir/credentials.json; account '$label' not saved." >&2
    exit 1
  fi

  if ! jq_write "$label_dir/oauthAccount.json" '.oauthAccount // {}' "$CLAUDE_JSON"; then
    # Do not leave a stale oauthAccount.json behind: on an OVERWRITE save,
    # jq_write's failure leaves the PREVIOUS account's identity file sitting
    # next to the NEW account's just-copied credentials.json. That mismatched
    # pair would otherwise pass the switch pre-flight's existence/content
    # checks and switch cleanly to the wrong identity. Removing it here makes
    # this snapshot look like a credentials-only save (no identity available)
    # instead of a confidently wrong one.
    rm -f "$label_dir/oauthAccount.json"
    echo "Error: failed to write $label_dir/oauthAccount.json; account '$label' not saved cleanly." >&2
    exit 1
  fi

  echo "Saved account '$label'."
}

cmd_list() {
  local labels
  labels="$(saved_labels)"
  if [[ -z "$labels" ]]; then
    echo "no saved accounts -- run: ccswitch save <label>"
    return 0
  fi

  local live_uuid=""
  if [[ -f "$CLAUDE_JSON" ]]; then
    live_uuid="$(live_account_uuid)"
  fi

  local label
  # Unquoted $labels is safe: see saved_labels' GUARANTEE.
  for label in $labels; do
    if [[ -n "$live_uuid" ]] && [[ "$(saved_account_uuid "$label")" == "$live_uuid" ]]; then
      echo "* $label"
    else
      echo "  $label"
    fi
  done
}

cmd_delete() {
  local label="${1:-}"

  validate_label "$label"

  local label_dir="$ACCOUNTS_DIR/$label"
  if [[ ! -d "$label_dir" ]]; then
    echo "Error: no saved account named '$label'." >&2
    exit 1
  fi

  if confirm "Delete account '$label'?"; then
    rm -rf "$label_dir"
    echo "Deleted account '$label'."
  else
    echo "Aborted."
  fi
}

cmd_switch() {
  local label="$1" relaunch="${2:-}"

  validate_label "$label"

  local label_dir="$ACCOUNTS_DIR/$label"

  if [[ ! -d "$label_dir" ]]; then
    echo "Error: no saved account named '$label'. Run: ccswitch save $label" >&2
    exit 1
  fi
  if [[ ! -f "$label_dir/credentials.json" ]]; then
    echo "Error: saved account '$label' is missing credentials.json." >&2
    exit 1
  fi

  # Validate the snapshot BEFORE touching any live file. A switch that fails
  # half-way (credentials swapped, .claude.json not) leaves the user logged
  # into a mismatched pair, so everything that can be checked up front is.
  if ! is_valid_json_object_file "$label_dir/credentials.json"; then
    echo "Error: saved account '$label' has an unreadable credentials.json; nothing changed." >&2
    echo "Re-enroll it: log into that account in Claude Code, then run: ccswitch save $label" >&2
    exit 1
  fi
  if [[ -f "$label_dir/oauthAccount.json" ]] \
    && ! is_valid_json_object_file "$label_dir/oauthAccount.json"; then
    echo "Error: saved account '$label' has an unreadable oauthAccount.json; nothing changed." >&2
    echo "Re-enroll it: log into that account in Claude Code, then run: ccswitch save $label" >&2
    exit 1
  fi

  require_claude_json

  # Save-on-leave: before we overwrite the live file, snapshot the account we
  # are switching AWAY from, so its (Claude-Code-rotated) tokens are preserved
  # and it can still refresh as a non-active account afterwards.
  mirror_live_to_snapshot

  mkdir -p "$CLAUDE_DIR"
  chmod 700 "$CLAUDE_DIR"

  # Backups are the user's only recovery path if the writes below fail
  # partway, so a failed backup must abort BEFORE anything live is touched --
  # not get swallowed by secure_copy's chmod masking a failed cp.
  if [[ -f "$CREDENTIALS_FILE" ]]; then
    if ! secure_copy "$CREDENTIALS_FILE" "$CREDENTIALS_FILE.bak"; then
      echo "Error: failed to back up $CREDENTIALS_FILE; nothing changed." >&2
      exit 1
    fi
  fi

  if ! secure_copy "$CLAUDE_JSON" "$CLAUDE_JSON.bak"; then
    echo "Error: failed to back up $CLAUDE_JSON; nothing changed." >&2
    exit 1
  fi

  # .claude.json is written AFTER this, below -- aborting here on failure
  # leaves a consistent state (nothing live has changed identity yet).
  if ! install_credentials "$label_dir/credentials.json" "$CREDENTIALS_FILE"; then
    echo "Error: failed to write $CREDENTIALS_FILE; nothing else was changed." >&2
    echo "$CLAUDE_JSON was not touched, so state is consistent." >&2
    # $CREDENTIALS_FILE.bak only exists when there WAS a live credentials
    # file to back up (see the guard above) -- on a machine with no prior
    # live credentials, pointing at a .bak that was never created would
    # send the user chasing a file that isn't there.
    if [[ -f "$CREDENTIALS_FILE.bak" ]]; then
      echo "Restore the previous credentials with:" >&2
      echo "  cp $CREDENTIALS_FILE.bak $CREDENTIALS_FILE" >&2
    fi
    exit 1
  fi

  local oauth_account_file="$label_dir/oauthAccount.json"
  if [[ -s "$oauth_account_file" ]]; then
    if ! jq_write "$CLAUDE_JSON" --slurpfile oauth "$oauth_account_file" '.oauthAccount = $oauth[0]' "$CLAUDE_JSON"; then
      echo "Error: failed to update $CLAUDE_JSON; it is unchanged." >&2
      echo "Credentials were already swapped." >&2
      # $CREDENTIALS_FILE.bak only exists when there WAS a live credentials
      # file to back up (see the guard above) -- on a machine with no prior
      # live credentials, pointing at a .bak that was never created would
      # send the user chasing a file that isn't there.
      if [[ -f "$CREDENTIALS_FILE.bak" ]]; then
        echo "Restore them with:" >&2
        echo "  cp $CREDENTIALS_FILE.bak $CREDENTIALS_FILE" >&2
      fi
      exit 1
    fi
  fi

  echo "Switched to $label. Restart Claude Code to apply."

  if [[ "$relaunch" == "--relaunch" ]]; then
    # exec replaces this process, so the EXIT trap never runs.
    cleanup_tmpdir

    # Intentionally unquoted: CCSWITCH_CLAUDE_CMD may hold a command plus
    # arguments (e.g. "claude --resume"), and relying on word-splitting here
    # is how those arguments reach exec. Do not "fix" this by quoting it.
    # shellcheck disable=SC2086
    exec ${CCSWITCH_CLAUDE_CMD:-claude}
  fi
}

# =============================================================================
# `usage` subcommand: all-account rate-limit monitor.
#
# Network/schema isolation (see constants block above for sourcing/caveats):
#   fetch_usage_raw  -- the ONLY function that curls the usage endpoint.
#   refresh_token     -- the ONLY function that curls the token endpoint.
#   parse_usage       -- the ONLY function that knows the usage JSON shape.
#   parse_refresh     -- the ONLY function that knows the refresh JSON shape.
# If Anthropic changes the API, one of these four functions is the fix.
# =============================================================================

# fetch_usage_raw <access_token> -> prints "<body>\n<http_status>" (curl's
# -w appends the status as a trailing line). Never logs the token or body.
#
# SECURITY: the bearer token is deliberately kept OUT of argv. Any argv a
# process is launched with is world-readable on a shared host via
# /proc/<pid>/cmdline for the duration of the call, regardless of shell
# quoting -- `-H "Authorization: Bearer $token"` would leak the token to
# anyone who can list processes at the right instant. Instead we write a
# curl config file (mode 600, this process's own tmp file) and point curl
# at it with --config; the URL itself is not secret and stays in argv (the
# test stub, and any `ps`/audit tooling, still identify the call by it).
fetch_usage_raw() {
  local token="$1"
  local cfgfile
  cfgfile="$(mktemp "$CCSWITCH_TMPDIR/usage-cfg.XXXXXX")"
  chmod 600 "$cfgfile"
  {
    printf 'header = "Authorization: Bearer %s"\n' "$token"
    printf 'header = "anthropic-beta: %s"\n' "$USAGE_API_BETA_HEADER"
  } >"$cfgfile"
  curl -sS -o - -w '\n%{http_code}' --config "$cfgfile" "$USAGE_API_URL" 2>/dev/null
  rm -f "$cfgfile"
}

# refresh_token <refresh_token> -> prints "<body>\n<http_status>", same
# convention as fetch_usage_raw. Only place that builds the refresh body.
#
# Transport is Node (see the Cloudflare note above), not curl. Overridable via
# $CCSWITCH_REFRESH_CMD (given "<bodyfile> <url>") so tests can stub it without
# a network call.
#
# SECURITY: the request BODY (refresh_token + client_id) stays off argv --
# written to a mode-600 tmp file; Node/the override reads it from disk. Only
# the file PATH and the (non-secret) URL are passed as arguments.
refresh_token() {
  local rt="$1"
  local req_body bodyfile
  req_body="$(jq -cn --arg rt "$rt" --arg cid "$OAUTH_CLIENT_ID" \
    '{grant_type: "refresh_token", refresh_token: $rt, client_id: $cid}')"
  bodyfile="$(mktemp "$CCSWITCH_TMPDIR/refresh-body.XXXXXX")"
  chmod 600 "$bodyfile"
  printf '%s' "$req_body" >"$bodyfile"

  if [[ -n "${CCSWITCH_REFRESH_CMD:-}" ]]; then
    "$CCSWITCH_REFRESH_CMD" "$bodyfile" "$TOKEN_REFRESH_URL"
  else
    node -e '
      const fs = require("fs");
      const [bodyFile, url, timeoutS] = process.argv.slice(1);
      const body = fs.readFileSync(bodyFile, "utf8");
      fetch(url, { method: "POST",
        headers: { "Content-Type": "application/json",
                   "Origin": "https://claude.ai", "Referer": "https://claude.ai/" },
        body,
        signal: AbortSignal.timeout(Number(timeoutS) * 1000) })
        .then(async r => { const t = await r.text(); process.stdout.write(t + "\n" + r.status); })
        .catch(() => process.stdout.write("\n000"));
    ' "$bodyfile" "$TOKEN_REFRESH_URL" "$REFRESH_TIMEOUT_SECONDS" 2>/dev/null
  fi

  rm -f "$bodyfile"
}

# split_http_response <raw> -> sets HTTP_STATUS and HTTP_BODY from the
# "<body>\n<status>" convention shared by fetch_usage_raw and refresh_token.
split_http_response() {
  local raw="$1"
  HTTP_STATUS="$(printf '%s' "$raw" | tail -n1)"
  HTTP_BODY="$(printf '%s' "$raw" | sed '$d')"
}

# iso_to_epoch_or_null <iso_string> -> epoch seconds, or the JSON literal
# `null` when the input is empty or unparseable. `null` (not "") is used so
# the value stays valid JSON for --argjson when it is cached.
iso_to_epoch_or_null() {
  local iso="$1" ep
  [[ -z "$iso" ]] && { echo "null"; return; }
  ep="$(date -d "$iso" +%s 2>/dev/null)"
  [[ -z "$ep" ]] && { echo "null"; return; }
  echo "$ep"
}

# parse_usage <json> -> echoes
# "five_hour_pct|seven_day_pct|five_hour_reset_epoch|seven_day_reset_epoch"
# on success, or returns non-zero with no output on any schema mismatch. This
# is the ONLY function that knows the usage response field names.
#
# Only the two utilization percentages are required. Either `resets_at` is
# OPTIONAL: the API returns `five_hour.resets_at` as null whenever 5-hour usage
# is 0% (no active window to reset), yet the weekly number is still valid and
# worth showing. A missing reset is emitted as the JSON literal `null` (so it
# stays valid for --argjson caching) and renders as a dash in its reset column,
# rather than discarding the whole row.
parse_usage() {
  local json="$1"

  echo "$json" | jq -e \
    '(.five_hour.utilization != null) and (.seven_day.utilization != null)' \
    >/dev/null 2>&1 || return 1

  local five_pct week_pct five_reset week_reset
  five_pct="$(echo "$json" | jq -r '.five_hour.utilization')"
  week_pct="$(echo "$json" | jq -r '.seven_day.utilization')"
  five_reset="$(iso_to_epoch_or_null "$(echo "$json" | jq -r '.five_hour.resets_at // empty')")"
  week_reset="$(iso_to_epoch_or_null "$(echo "$json" | jq -r '.seven_day.resets_at // empty')")"

  echo "${five_pct}|${week_pct}|${five_reset}|${week_reset}"
}

# parse_refresh <json> -> echoes "access_token|expires_in|refresh_token" on
# success (refresh_token is empty-string when the response didn't rotate
# it), or returns non-zero with no output on any schema mismatch. This is
# the ONLY function that knows the token-refresh response field names.
parse_refresh() {
  local json="$1"

  echo "$json" | jq -e '(.access_token != null) and (.expires_in != null)' \
    >/dev/null 2>&1 || return 1

  local access_token expires_in refresh_token_val
  access_token="$(echo "$json" | jq -r '.access_token')"
  expires_in="$(echo "$json" | jq -r '.expires_in')"
  refresh_token_val="$(echo "$json" | jq -r '.refresh_token // empty')"

  [[ -n "$access_token" ]] || return 1
  [[ "$expires_in" =~ ^[0-9]+$ ]] || return 1

  echo "${access_token}|${expires_in}|${refresh_token_val}"
}

# is_active_account <label> -> true if this account's saved accountUuid
# matches the live one (same identity cmd_list uses for its '*' marker).
# Anchored on accountUuid rather than refreshToken -- see the comment above
# live_account_uuid for why refreshToken cannot be used for this.
is_active_account() {
  local label="$1"
  [[ ! -f "$CLAUDE_JSON" ]] && return 1
  local live_uuid
  live_uuid="$(live_account_uuid)"
  [[ -n "$live_uuid" ]] && [[ "$(saved_account_uuid "$label")" == "$live_uuid" ]]
}

# holds_live_refresh_token <label> -> true if this account's snapshot holds the
# very refresh token $CREDENTIALS_FILE also holds.
#
# This is NOT an identity check; is_active_account is, and stays anchored on
# accountUuid. This answers a narrower question: would rotating this snapshot's
# refresh token invalidate the token the running Claude Code still depends on?
# The refresh endpoint rotates single-use, so a shared token means yes, always.
holds_live_refresh_token() {
  local label="$1"
  local live_rt snap_rt
  live_rt="$(jq -r '.claudeAiOauth.refreshToken // empty' "$CREDENTIALS_FILE" 2>/dev/null)"
  [[ -n "$live_rt" ]] || return 1
  snap_rt="$(jq -r '.claudeAiOauth.refreshToken // empty' \
    "$ACCOUNTS_DIR/$label/credentials.json" 2>/dev/null)"
  [[ "$snap_rt" == "$live_rt" ]]
}

# is_live_session_account <label> -> true when this account backs the running
# Claude Code session, by EITHER of the two signals available. Everything that
# must not touch the live session's tokens gates on this, not on
# is_active_account alone.
#
# Why the second arm exists: is_active_account FAILS OPEN. With no
# .oauthAccount.accountUuid in ~/.claude.json -- a fresh profile, a hand-trimmed
# file, a Claude Code that has not written it yet -- live_account_uuid is empty,
# so EVERY account reads as non-active. The non-active branch is the one that
# refreshes, so ccswitch rotated the live session's refresh token, wrote the
# rotated value to the snapshot only, and left ~/.claude/.credentials.json
# holding a token the server had already consumed. Claude Code's next refresh
# then failed and the user was forced to re-login.
#
# Same failure as b4199a8, reached through identity-UNKNOWN rather than
# identity-mismatch, which is why anchoring on accountUuid alone did not close
# it. Token equality needs no identity file to be correct.
is_live_session_account() {
  local label="$1"
  is_active_account "$label" && return 0
  holds_live_refresh_token "$label"
}

# resolve_account_credentials <label> -> echoes "access|expiresAt|refreshToken".
# For the active account, the accessToken/expiresAt come from the LIVE
# credentials file (freshest available); the refreshToken always comes from
# the account's own snapshot, since that is the file we write refresh results
# back into. Missing fields come through as empty strings, never as errors.
resolve_account_credentials() {
  local label="$1"
  local snapshot_file="$ACCOUNTS_DIR/$label/credentials.json"
  [[ ! -f "$snapshot_file" ]] && { echo "||"; return 0; }

  # The live file is the freshest source for the live-session account -- which
  # includes the case where identity could not be resolved and only token
  # equality gives it away. Without that second arm, the refresh gate below
  # would correctly refuse to refresh such an account and then render it from a
  # stale snapshot access token, i.e. a dash.
  local source_file="$snapshot_file"
  is_live_session_account "$label" && source_file="$CREDENTIALS_FILE"

  local access exp refresh
  access="$(jq -r '.claudeAiOauth.accessToken // empty' "$source_file" 2>/dev/null)"
  exp="$(jq -r '.claudeAiOauth.expiresAt // empty' "$source_file" 2>/dev/null)"
  refresh="$(jq -r '.claudeAiOauth.refreshToken // empty' "$snapshot_file" 2>/dev/null)"

  echo "${access}|${exp}|${refresh}"
}

# is_token_expired <expires_at_ms> -> true iff expires_at_ms is a valid
# epoch-millisecond timestamp that is now, plus a skew margin (or already
# past). An unparseable or missing value is treated as "not expired" -- the
# usage call itself will fail cleanly (row shows dashes) rather than us
# guessing wrong and forcing an unnecessary refresh.
is_token_expired() {
  local exp="$1"
  [[ "$exp" =~ ^[0-9]+$ ]] || return 1
  local now_ms=$(( ($(date +%s) + TOKEN_EXPIRY_SKEW_SECONDS) * 1000 ))
  (( exp <= now_ms ))
}

# attempt_refresh <label> <refresh_token> -> on success, echoes the new
# access token and atomically rewrites accounts/<label>/credentials.json's
# accessToken + expiresAt (mode 600); on any failure (empty refresh token,
# non-2xx, unparseable response) returns non-zero and touches nothing.
#
# Refresh tokens rotate: when the response includes a new refresh_token, it
# is ALSO persisted here. This is safe to do unconditionally now because
# active-account identity is anchored on accountUuid (see is_active_account),
# not on refreshToken equality -- a rotated refreshToken no longer breaks
# active detection the way it would have before that change.
# Refresh-backoff: a shared marker file (one per accounts dir) recording when a
# 429 window ends, so a burst of expired accounts stops calling the endpoint
# after the first rate-limit instead of hammering it.
# Manual pause switch: while this flag file exists, ccswitch never calls the
# refresh endpoint (rows with an expired token show the wait state instead).
# Use `ccswitch refresh-pause` / `refresh-resume` to toggle it. Meant for when
# the refresh endpoint is rate-limiting a machine's IP and you want to stop
# adding pressure without losing the (GET-only) usage view.
NO_REFRESH_FLAG="$ACCOUNTS_DIR/.no-refresh"

REFRESH_BACKOFF_FILE="$ACCOUNTS_DIR/.refresh-backoff"
is_refresh_backoff() {
  local until
  until="$(cat "$REFRESH_BACKOFF_FILE" 2>/dev/null)"
  [[ "$until" =~ ^[0-9]+$ ]] && (( $(date +%s) < until ))
}
set_refresh_backoff() {
  mkdir -p "$ACCOUNTS_DIR"
  printf '%s' "$(( $(date +%s) + REFRESH_BACKOFF_SECONDS ))" >"$REFRESH_BACKOFF_FILE"
}

# attempt_refresh <label> <rt> -> exit status: 0 success (echoes new access
# token), 2 rate-limited/backoff (transient -- do NOT treat as dead), 1 any
# other failure (genuine -- needs re-login).
# retire_snapshot_refresh_token <label>: blank the snapshot's refreshToken, so a
# token the server may already have consumed can never be sent again. Costs one
# re-login of that account; the replay it prevents costs the whole grant family.
retire_snapshot_refresh_token() {
  local label="$1"
  local f="$ACCOUNTS_DIR/$label/credentials.json"
  [[ -f "$f" ]] || return 0
  jq_write "$f" '.claudeAiOauth.refreshToken = ""' "$f"
}

# refresh_inflight_marker <label> -> the path of that account's in-flight
# marker. Holds no secret: its existence is the whole signal.
refresh_inflight_marker() {
  echo "$ACCOUNTS_DIR/$1/.refresh-inflight"
}

attempt_refresh() {
  local label="$1" rt="$2"
  [[ -z "$rt" ]] && return 1

  # Refresh manually paused -> never touch the endpoint.
  [[ -f "$NO_REFRESH_FLAG" ]] && return 2

  # Don't call the endpoint during an active 429 backoff window.
  is_refresh_backoff && return 2

  local marker
  marker="$(refresh_inflight_marker "$label")"

  # A marker left behind means an earlier run POSTed this refresh token and
  # never recorded what came back -- it was interrupted, or its write-back
  # failed. The server may already have rotated it, and OAuth refresh tokens
  # here are single-use: re-sending a consumed one is read as token theft and
  # revokes every token in the grant family. So retire it rather than find out.
  if [[ -f "$marker" ]]; then
    retire_snapshot_refresh_token "$label" && rm -f "$marker"
    return 1
  fi

  : >"$marker" 2>/dev/null || return 1
  chmod 600 "$marker" 2>/dev/null

  local raw
  raw="$(refresh_token "$rt")"
  split_http_response "$raw"

  # Any status we actually received settles the question: 429/4xx/5xx means the
  # server did not rotate, 2xx means it did. Only an outcome never learned (the
  # process died mid-POST) leaves the marker in place for the next run to find.
  if [[ "$HTTP_STATUS" == "429" ]]; then
    rm -f "$marker"
    set_refresh_backoff
    return 2
  fi

  if ! [[ "$HTTP_STATUS" =~ ^2[0-9][0-9]$ ]]; then
    rm -f "$marker"
    return 1
  fi

  # Past this point the server HAS rotated and $rt is spent. Every exit below
  # must leave the snapshot holding the NEW token or no token -- never the
  # spent one. Where the retire write itself fails, the marker is deliberately
  # NOT cleared: it is then the only thing left standing between the next run
  # and a replay.
  local parsed new_access new_expires_in new_refresh
  if ! parsed="$(parse_refresh "$HTTP_BODY")"; then
    retire_snapshot_refresh_token "$label" && rm -f "$marker"
    return 1
  fi
  IFS='|' read -r new_access new_expires_in new_refresh <<<"$parsed"

  local new_expires_at_ms=$(( $(date +%s) * 1000 + new_expires_in * 1000 ))
  local snapshot_file="$ACCOUNTS_DIR/$label/credentials.json"
  if ! jq_write "$snapshot_file" --arg at "$new_access" --argjson exp "$new_expires_at_ms" --arg rt "$new_refresh" \
    '.claudeAiOauth.accessToken = $at
     | .claudeAiOauth.expiresAt = $exp
     | if ($rt != "") then .claudeAiOauth.refreshToken = $rt else . end' \
    "$snapshot_file"; then
    retire_snapshot_refresh_token "$label" && rm -f "$marker"
    return 1
  fi

  rm -f "$marker"
  echo "$new_access"
}

usage_cache_file() {
  echo "$ACCOUNTS_DIR/$1/.usage-cache"
}

# read_usage_cache <label> -> echoes cache JSON, or "{}" if missing/corrupt.
read_usage_cache() {
  local cache_file
  cache_file="$(usage_cache_file "$1")"
  local content
  content="$(cat "$cache_file" 2>/dev/null)"
  # `jq -e .` also treats a literal top-level `null` (valid JSON, e.g. an
  # empty/truncated write) as "invalid" -- exit code 1 -- so that case
  # self-heals to "{}" here too, not just missing-file/corrupt-JSON.
  echo "$content" | jq -e . >/dev/null 2>&1 && echo "$content" || echo "{}"
}

# write_usage_cache <label> <json> -> writes atomically (tmp file + rename,
# same pattern as attempt_refresh's credentials write-back) so a reader
# never observes a partially-written cache file.
write_usage_cache() {
  local label="$1" json="$2"
  file_write "$(usage_cache_file "$label")" "$json"
}

# fetch_and_cache_usage <label> <access_token> <bypass_cache: 0|1> -> echoes
# "five_hour_pct|seven_day_pct|five_hour_reset_epoch|seven_day_reset_epoch"
# (all empty on failure). Cache TTL and the 429 backoff are both handled here
# so callers never see the difference between "fresh" and "served from cache".
fetch_and_cache_usage() {
  local label="$1" token="$2" bypass_cache="$3"
  local now cache
  now="$(date +%s)"
  cache="$(read_usage_cache "$label")"

  local rate_limited_until fetched_at cached_5h cached_7d cached_5reset cached_7reset
  rate_limited_until="$(echo "$cache" | jq -r '.rate_limited_until // empty')"
  fetched_at="$(echo "$cache" | jq -r '.fetched_at // empty')"
  cached_5h="$(echo "$cache" | jq -r '.five_hour_pct // empty')"
  cached_7d="$(echo "$cache" | jq -r '.seven_day_pct // empty')"
  cached_5reset="$(echo "$cache" | jq -r '.five_hour_reset_epoch // empty')"
  cached_7reset="$(echo "$cache" | jq -r '.seven_day_reset_epoch // empty')"

  # The 5th output field is the LIVE HTTP status (empty when served from cache
  # or a backoff window, "429" when rate-limited, else the raw status). The
  # caller uses it to distinguish an auth failure (401/403) -- which warrants a
  # token refresh + retry -- from other failures. It cannot be a global: this
  # function runs inside $(...), a subshell, so a global set here would not
  # survive. It rides back as data instead.

  # A 429 backoff window is honored even with --refresh: hammering an
  # endpoint that just rate-limited us is never the right override.
  if [[ -n "$rate_limited_until" ]] && (( now < rate_limited_until )); then
    [[ -n "$cached_5h" ]] && echo "${cached_5h}|${cached_7d}|${cached_5reset}|${cached_7reset}|" || echo "||||"
    return 0
  fi

  if [[ "$bypass_cache" != "1" ]] \
    && [[ -n "$fetched_at" ]] \
    && (( now - fetched_at < USAGE_CACHE_TTL_SECONDS )) \
    && [[ -n "$cached_5h" ]]; then
    echo "${cached_5h}|${cached_7d}|${cached_5reset}|${cached_7reset}|"
    return 0
  fi

  local raw
  raw="$(fetch_usage_raw "$token")"
  split_http_response "$raw"

  if [[ "$HTTP_STATUS" == "429" ]]; then
    local new_cache
    new_cache="$(echo "$cache" | jq --argjson rl "$((now + USAGE_RATE_LIMIT_BACKOFF_SECONDS))" '.rate_limited_until = $rl')"
    write_usage_cache "$label" "$new_cache"
    [[ -n "$cached_5h" ]] && echo "${cached_5h}|${cached_7d}|${cached_5reset}|${cached_7reset}|429" || echo "||||429"
    return 0
  fi

  if ! [[ "$HTTP_STATUS" =~ ^2[0-9][0-9]$ ]]; then
    echo "||||${HTTP_STATUS}"
    return 0
  fi

  local parsed
  if ! parsed="$(parse_usage "$HTTP_BODY")"; then
    echo "||||${HTTP_STATUS}"
    return 0
  fi

  local p5 p7 p5reset p7reset
  IFS='|' read -r p5 p7 p5reset p7reset <<<"$parsed"
  local new_cache
  new_cache="$(jq -n --argjson fa "$now" --argjson p5 "$p5" --argjson p7 "$p7" --argjson pr5 "$p5reset" --argjson pr7 "$p7reset" \
    '{fetched_at: $fa, five_hour_pct: $p5, seven_day_pct: $p7, five_hour_reset_epoch: $pr5, seven_day_reset_epoch: $pr7, rate_limited_until: null}')"
  write_usage_cache "$label" "$new_cache"

  echo "${p5}|${p7}|${p5reset}|${p7reset}|${HTTP_STATUS}"
}

# --- meter rendering (mirrors statusline-usage.sh's aesthetic: eighth-block
# fill + middle-dot track + 256-color thresholds) -----------------------------
USAGE_PCT_OK_MAX=59
USAGE_PCT_WARN_MAX=85
USAGE_COLOR_OK=108
USAGE_COLOR_WARN=179
USAGE_COLOR_CRIT=167
USAGE_COLOR_DIM=245
USAGE_COLOR_TRACK=240
USAGE_EIGHTHS=("" "▏" "▎" "▍" "▌" "▋" "▊" "▉" "█")

usage_color_for() {
  local pct="$1"
  if (( pct > USAGE_PCT_WARN_MAX )); then
    echo "$USAGE_COLOR_CRIT"
  elif (( pct > USAGE_PCT_OK_MAX )); then
    echo "$USAGE_COLOR_WARN"
  else
    echo "$USAGE_COLOR_OK"
  fi
}

usage_render_meter() {
  local pct="$1" width="$2" color
  color="$(usage_color_for "$pct")"

  local total_eighths full_cells frac_eighths empty_cells bar track i
  total_eighths="$(awk -v p="$pct" -v w="$width" 'BEGIN {
    v = (p / 100.0) * w * 8.0
    printf "%d", (v - int(v) >= 0.5) ? int(v) + 1 : int(v)
  }')"
  full_cells=$(( total_eighths / 8 ))
  frac_eighths=$(( total_eighths % 8 ))
  if (( full_cells > width )); then
    full_cells=$width
    frac_eighths=0
  fi
  empty_cells=$(( width - full_cells - (frac_eighths > 0 ? 1 : 0) ))
  (( empty_cells < 0 )) && empty_cells=0

  bar=""
  for (( i = 0; i < full_cells; i++ )); do bar+="█"; done
  (( frac_eighths > 0 )) && bar+="${USAGE_EIGHTHS[$frac_eighths]}"
  track=""
  for (( i = 0; i < empty_cells; i++ )); do track+="·"; done

  printf '\033[38;5;%sm%s\033[38;5;%sm%s\033[0m' "$color" "$bar" "$USAGE_COLOR_TRACK" "$track"
}

usage_round_pct() {
  awk -v v="$1" 'BEGIN { p = (v < 0) ? 0 : v; printf "%d", p + 0.5 }'
}

# usage_dim <text> -> text in the same dim/secondary color statusline-usage.sh
# uses for labels (mirrors its dim()). Used for the table header and the
# reset countdown, which are secondary information next to the meters.
usage_dim() {
  printf '\033[38;5;%sm%s\033[0m' "$USAGE_COLOR_DIM" "$1"
}

# usage_fmt_reset <epoch_seconds> -> short human countdown ("2h 14m").
usage_fmt_reset() {
  local epoch="$1"
  [[ "$epoch" =~ ^[0-9]+$ ]] || { echo "—"; return; }
  local now delta
  now="$(date +%s)"
  delta=$(( epoch - now ))
  (( delta <= 0 )) && { echo "0m"; return; }
  if (( delta < 3600 )); then
    echo "$(( delta / 60 ))m"
  elif (( delta < 86400 )); then
    echo "$(( delta / 3600 ))h $(( (delta % 3600) / 60 ))m"
  else
    echo "$(( delta / 86400 ))d $(( (delta % 86400) / 3600 ))h"
  fi
}

# Width of a reset column; matches the "RESET(5h)" header label so the two
# reset columns line up.
USAGE_RESET_WIDTH=9

# usage_reset_cell <epoch_or_null> -> the dim reset countdown, padded to a
# fixed VISIBLE width. The em-dash placeholder is multibyte (3 bytes, 1
# column), so its width is corrected explicitly; every other value is ASCII.
usage_reset_cell() {
  local txt vis pad
  txt="$(usage_fmt_reset "$1")"
  vis=${#txt}
  [[ "$txt" == "—" ]] && vis=1
  pad=$(( USAGE_RESET_WIDTH - vis ))
  (( pad < 0 )) && pad=0
  usage_dim "$(printf '%s%*s' "$txt" "$pad" "")"
}

# --- usage row building: three phases -----------------------------------------
# The per-account work is one independent HTTP GET, so it fans out (see
# cmd_usage). Refreshing does NOT: it is serialized deliberately, and the split
# below is what makes that separation enforceable.

# resolve_row_state <label> -> "<state>|<marker>|<access>|<refresh>|<did_refresh>"
# state is EMPTY when there is a usable access token; otherwise it is the
# terminal row state (dash/wait/relogin) and the rest is meaningless.
#
# MUST be called serially. It may call attempt_refresh, and the 429 backoff is
# a single shared file: concurrent callers would each read it before any of
# them wrote it, which is exactly the re-login storm deb49e6 fixed.
resolve_row_state() {
  local label="$1"
  # 'marker' is an identity display and stays anchored on accountUuid, so the
  # '*' here keeps agreeing with `ccswitch list`. 'active' is the refresh SAFETY
  # gate and is deliberately wider -- see is_live_session_account.
  local marker="  " active=0
  is_active_account "$label" && marker="* "
  is_live_session_account "$label" && active=1

  local access exp refresh
  IFS='|' read -r access exp refresh <<<"$(resolve_account_credentials "$label")"

  if [[ -z "$access" ]] && [[ -z "$refresh" ]]; then
    echo "dash|${marker}|||0"
    return 0
  fi

  # NEVER refresh the LIVE-SESSION account. Its tokens live in $CREDENTIALS_FILE and
  # are owned by the running Claude Code, which rotates them there itself. If
  # ccswitch refreshed it, attempt_refresh would write the rotated token only to
  # the snapshot and leave the live file holding an invalidated refresh token ->
  # Claude Code's next refresh fails and the logged-in account "expires" (a
  # regression the live->snapshot mirror made reachable, since the mirrored
  # snapshot token is valid enough to rotate). So for the active account we only
  # READ its live access token; a missing/expired one just shows a state and
  # Claude Code refreshes it.
  local did_refresh=0
  if [[ "$active" != "1" ]] && { [[ -z "$access" ]] || is_token_expired "$exp"; }; then
    local refreshed rc
    refreshed="$(attempt_refresh "$label" "$refresh")"; rc=$?
    if [[ "$rc" == "0" ]]; then
      access="$refreshed"
      did_refresh=1
    elif [[ "$rc" == "2" ]]; then
      echo "wait|${marker}|||0"   # rate-limited: transient, not dead
      return 0
    else
      echo "relogin|${marker}|||0"
      return 0
    fi
  fi

  if [[ -z "$access" ]]; then
    echo "dash|${marker}|||0"
    return 0
  fi

  echo "|${marker}|${access}|${refresh}|${did_refresh}"
}

# fetch_row_usage <label> <access_token> -> the 5-field string
# fetch_and_cache_usage returns. Pure GET plus a per-account cache write; no
# shared state, so this is the part that fans out.
fetch_row_usage() {
  fetch_and_cache_usage "$1" "$2" "$USAGE_BYPASS_CACHE"
}

# finish_row <label> <marker> <access> <refresh> <did_refresh> <fetch_result>
# -> "label|marker|state|p5|p7|p5reset|p7reset". state is one of: ok, dash,
# wait, relogin. Never lets one account's failure abort the loop -- every
# failure mode resolves to a row, not an exit.
#
# Called serially, because the 401/403 path refreshes (see resolve_row_state).
# That path is rare: it only fires when a token was rejected without having
# time-expired -- revoked, or rotated by a real Claude Code session -- so
# is_token_expired never triggered a refresh in phase 1.
finish_row() {
  local label="$1" marker="$2" access="$3" refresh="$4" did_refresh="$5" fetch_result="$6"
  # The refresh safety gate, not the '*' marker -- see is_live_session_account.
  local active=0
  is_live_session_account "$label" && active=1

  local p5 p7 p5reset p7reset httpstatus
  IFS='|' read -r p5 p7 p5reset p7reset httpstatus <<<"$fetch_result"

  # Auth failure on a token we did NOT already refresh: refresh once and retry
  # the fetch. If the refresh itself fails, the account genuinely needs a
  # re-login.
  if [[ "$active" != "1" ]] && [[ -z "$p5" ]] && [[ "$did_refresh" == "0" ]] \
    && { [[ "$httpstatus" == "401" ]] || [[ "$httpstatus" == "403" ]]; } \
    && [[ -n "$refresh" ]]; then
    local retried rc2
    retried="$(attempt_refresh "$label" "$refresh")"; rc2=$?
    if [[ "$rc2" == "0" ]]; then
      IFS='|' read -r p5 p7 p5reset p7reset httpstatus <<<"$(fetch_and_cache_usage "$label" "$retried" 1)"
    elif [[ "$rc2" == "2" ]]; then
      echo "${label}|${marker}|wait||||"   # rate-limited: transient, not dead
      return 0
    else
      echo "${label}|${marker}|relogin||||"
      return 0
    fi
  fi

  if [[ -z "$p5" ]]; then
    echo "${label}|${marker}|dash||||"
  else
    echo "${label}|${marker}|ok|${p5}|${p7}|${p5reset}|${p7reset}"
  fi
}

# find_headroom_label <<< rows: pipe of "label|state|five_pct|week_pct" ->
# echoes the label with the MOST headroom among rows in the "ok" state. A
# window with the most headroom is the one whose tighter limit (the higher of
# its 5-hour and weekly utilization) is lowest -- an account at 0% 5h but 100%
# weekly has no real headroom, so weekly must count too. Empty output if no
# row is in the "ok" state.
find_headroom_label() {
  awk -F'|' '
    $2 == "ok" {
      u = ($3 + 0 > $4 + 0) ? $3 + 0 : $4 + 0
      if (!seen || u < best) { best = u; label = $1; seen = 1 }
    }
    END { if (seen) print label }
  '
}

# render_usage_cell <state> <pct> -> a cell string of a FIXED VISIBLE width
# (USAGE_CELL_WIDTH), regardless of state. This matters because the "ok"
# cell is full of ANSI color codes: padding a colored string afterward with
# `printf '%-Ns'` counts the escape-code bytes toward N, so the visible
# padding shrinks to nothing and columns run together. Building every
# variant to the same VISIBLE width up front means the caller never needs
# to pad a colored string -- a fixed literal separator between cells is
# enough.
USAGE_CELL_WIDTH=$(( USAGE_METER_WIDTH + 5 )) # meter + " " + "NNN%"/"  N%" (4 chars)
render_usage_cell() {
  local state="$1" pct="$2"
  case "$state" in
    ok)
      local pct_int pct_text
      pct_int="$(usage_round_pct "$pct")"
      pct_text="$(printf '%3d%%' "$pct_int")" # always 4 visible chars
      printf '%s %s' "$(usage_render_meter "$pct_int" "$USAGE_METER_WIDTH")" "$pct_text"
      ;;
    relogin) printf '%-*s' "$USAGE_CELL_WIDTH" "re-login" ;;
    wait) printf '%-*s' "$USAGE_CELL_WIDTH" "rate-limited" ;;
    *) printf '%-*s' "$USAGE_CELL_WIDTH" $'\xe2\x80\x94' ;; # em dash
  esac
}

# warn_if_refresh_unavailable: print ONE stderr warning per run when the
# built-in refresh transport cannot work, so an unusable node reads as a node
# problem instead of surfacing per-account as "re-login".
#
# The transport is Node's fetch(), which landed in Node 18; on anything older
# the refresh POST fails and every expired account looks revoked. Silent when
# $CCSWITCH_REFRESH_CMD is set -- that override replaces node entirely (it is
# also how the tests stub the network).
warn_if_refresh_unavailable() {
  [[ -n "${CCSWITCH_REFRESH_CMD:-}" ]] && return 0

  if ! command -v node >/dev/null 2>&1; then
    echo "Warning: node not found on PATH. Expired account tokens cannot be refreshed" >&2
    echo "(the refresh endpoint is behind Cloudflare, which blocks headless curl), so" >&2
    echo "rows for expired accounts will show 're-login' until node is installed." >&2
    return 0
  fi

  if ! node -e 'process.exit(typeof fetch === "function" ? 0 : 1)' >/dev/null 2>&1; then
    echo "Warning: this node is too old to refresh tokens -- fetch() requires node 18+." >&2
    echo "Rows for expired accounts will show 're-login' regardless of account health." >&2
    echo "Claude Code ships a modern node; putting it first on PATH fixes this." >&2
  fi
}

cmd_usage() {
  local no_switch=0 bypass_cache=0 relaunch=""
  local arg
  for arg in "$@"; do
    case "$arg" in
      --no-switch) no_switch=1 ;;
      --refresh) bypass_cache=1 ;;
      --relaunch) relaunch="--relaunch" ;;
      *)
        echo "Error: unknown option '$arg' for 'usage'." >&2
        exit 1
        ;;
    esac
  done
  USAGE_BYPASS_CACHE="$bypass_cache"

  local labels
  labels="$(saved_labels)"
  if [[ -z "$labels" ]]; then
    echo "no saved accounts -- run: ccswitch save <label>"
    return 0
  fi

  warn_if_refresh_unavailable

  # Keep the active account's snapshot current on every poll (the CtrlA poller
  # runs this every 5 min), so its refresh token never goes stale behind
  # Claude Code's back.
  mirror_live_to_snapshot

  # Row building runs in three phases so the one part that is a per-account
  # network round trip -- the usage GET -- can overlap, while token refreshes
  # stay strictly serial (see resolve_row_state for why that is not optional).
  #
  # Unquoted $labels is safe throughout (see saved_labels' GUARANTEE), and no
  # element can escape the per-label file names below.

  # Phase 1 (serial): resolve each account's token, refreshing where needed.
  # Serial on purpose -- see resolve_row_state.
  local resolve_dir="$CCSWITCH_TMPDIR/resolve"
  mkdir -p "$resolve_dir" && chmod 700 "$resolve_dir"
  local label
  for label in $labels; do
    # Each line carries that account's access AND refresh token, so the file is
    # created 600 BEFORE anything is written into it -- the same rule
    # fetch_usage_raw's curl config file follows. $CCSWITCH_TMPDIR is already
    # 700; this is the second lock, not the only one.
    : >"$resolve_dir/$label"
    chmod 600 "$resolve_dir/$label"
    resolve_row_state "$label" >"$resolve_dir/$label"
  done

  # Phase 2 (parallel, capped): the usage GET for every account that has a
  # token. This is the per-account round trip, and it touches nothing shared.
  # Each job writes its own file -- never stdout, which is the rendered table.
  # (Background jobs are subshells, so they do NOT inherit the EXIT trap and
  # cannot delete $CCSWITCH_TMPDIR out from under the run.)
  local fetch_dir="$CCSWITCH_TMPDIR/fetch"
  mkdir -p "$fetch_dir" && chmod 700 "$fetch_dir"
  local inflight=0 state marker access refresh did_refresh
  for label in $labels; do
    # Clear FIRST, every iteration. If the redirect below ever fails (a missing
    # phase-1 file -- only reachable if phase 1 could not write it at all),
    # `read` never runs, and without the reset these would silently keep the
    # PREVIOUS label's values: one account's token fetching, and caching,
    # another account's usage.
    state=""; marker=""; access=""; refresh=""; did_refresh=""
    IFS='|' read -r state marker access refresh did_refresh <"$resolve_dir/$label"
    # A terminal state needs no GET. The empty-token guard is belt-and-braces:
    # resolve_row_state never emits an empty state with no token, so this only
    # fires if its file could not be written at all -- and a GET with an empty
    # bearer is never worth sending.
    { [[ -n "$state" ]] || [[ -z "$access" ]]; } && continue
    fetch_row_usage "$label" "$access" >"$fetch_dir/$label" &
    inflight=$((inflight + 1))
    if [[ "$inflight" -ge "$USAGE_MAX_PARALLEL" ]]; then
      wait
      inflight=0
    fi
  done
  wait

  # Phase 3 (serial): assemble rows in label order, running the rare 401/403
  # refresh-and-retry. Order is the sorted label order saved_labels produces, so
  # output does not depend on which fetch finished first.
  local rows="" headroom_lookup="" row fetch_result
  for label in $labels; do
    state=""; marker=""; access=""; refresh=""; did_refresh=""   # see phase 2
    IFS='|' read -r state marker access refresh did_refresh <"$resolve_dir/$label"
    if [[ -n "$state" ]]; then
      row="${label}|${marker}|${state}||||"
    else
      fetch_result="$(cat "$fetch_dir/$label" 2>/dev/null)"
      row="$(finish_row "$label" "$marker" "$access" "$refresh" "$did_refresh" "$fetch_result")"
    fi
    rows+="${row}"$'\n'
    headroom_lookup+="$(echo "$row" | awk -F'|' '{print $1"|"$3"|"$4"|"$5}')"$'\n'
  done

  local headroom_label
  headroom_label="$(echo "$headroom_lookup" | find_headroom_label)"

  local header_text
  header_text="$(printf '%-14s%-*s   %-*s   %-*s   %s' \
    "  ACCOUNT" "$USAGE_CELL_WIDTH" "5H" "$USAGE_CELL_WIDTH" "WEEK" \
    "$USAGE_RESET_WIDTH" "RESET(5h)" "RESET(wk)")"
  printf '%s\n' "$(usage_dim "$header_text")"
  local marker state p5 p7 p5reset p7reset line
  while IFS='|' read -r label marker state p5 p7 p5reset p7reset; do
    [[ -z "$label" ]] && continue
    line="$(printf '%-14s' "${marker}${label}")"
    line+="$(render_usage_cell "$state" "$p5")"
    line+="   "
    line+="$(render_usage_cell "$state" "$p7")"
    line+="   "
    line+="$(usage_reset_cell "$p5reset")"
    line+="   "
    line+="$(usage_reset_cell "$p7reset")"
    if [[ -n "$headroom_label" ]] && [[ "$label" == "$headroom_label" ]]; then
      line+="  <- most headroom"
    fi
    printf '%s\n' "$line"
  done <<<"$rows"

  if [[ "$no_switch" == "1" ]]; then
    return 0
  fi

  local choice
  echo
  if ! read -r -p "switch to which? [label / enter to cancel] " choice; then
    return 0
  fi
  [[ -z "$choice" ]] && return 0

  if [[ ! -d "$ACCOUNTS_DIR/$choice" ]]; then
    echo "Error: no saved account named '$choice'. Nothing changed." >&2
    return 0
  fi

  cmd_switch "$choice" "$relaunch"
}

usage_text() {
  cat <<'EOF'
ccswitch - save, list, switch between, and monitor Claude Code accounts.

COMMANDS
  ccswitch                     list saved accounts ('*' marks the active one)
  ccswitch list                same as above
  ccswitch save <label>        snapshot the CURRENTLY active account as <label>
  ccswitch <label>             switch to a saved account (then restart Claude Code)
  ccswitch <label> --relaunch  switch, then exec the claude CLI right away
  ccswitch delete <label>      remove a saved account (asks to confirm)
  ccswitch usage               show 5h/week usage for every saved account,
                               then optionally prompt which one to switch to
  ccswitch refresh-pause       stop refreshing tokens (usage still readable);
                               use when the refresh endpoint is rate-limiting
  ccswitch refresh-resume      re-enable token refresh
  ccswitch help                show this help (also -h, --help)
  ccswitch version             print the version (also --version, -V)

usage FLAGS
  --no-switch   just print the table, do not prompt to switch
  --refresh     bypass the 10-minute usage cache and re-poll now
  --relaunch    after switching from the prompt, exec the claude CLI

LABELS
  Any name of letters, digits, '_' or '-' (e.g. work, personal, claude001).

GETTING STARTED (enroll each account once)
  1. Log into an account normally in Claude Code, then:  ccswitch save work
  2. Log into another account (claude -> /login), then:  ccswitch save personal
  3. From then on:  ccswitch            (see them + who is active)
                    ccswitch personal   (switch; restart Claude Code to apply)
                    ccswitch usage       (compare headroom, pick where to go)

NOTES
  Switching swaps stored credentials, so a running Claude Code must be
  restarted to pick up the change (--relaunch / the `ccw` shell function do
  this for you). Tip: `ccw <label>` = switch + relaunch in one step.
  Tokens never leave your machine; saved accounts live under ~/.claude/accounts/.
EOF
}

main() {
  local cmd="${1:-}"

  case "$cmd" in
    save)
      shift
      cmd_save "${1:-}"
      ;;
    delete)
      shift
      cmd_delete "${1:-}"
      ;;
    list | "")
      cmd_list
      ;;
    usage)
      shift
      cmd_usage "$@"
      ;;
    refresh-pause)
      mkdir -p "$ACCOUNTS_DIR"
      : >"$NO_REFRESH_FLAG"
      echo "Refresh paused. 'ccswitch usage' still reads usage but will not"
      echo "refresh tokens (expired accounts show 'rate-limited'). Resume with:"
      echo "  ccswitch refresh-resume"
      ;;
    refresh-resume)
      rm -f "$NO_REFRESH_FLAG"
      echo "Refresh resumed. Tokens will refresh normally again."
      ;;
    help | -h | --help)
      usage_text
      ;;
    version | --version | -V)
      echo "ccswitch $CCSWITCH_VERSION"
      ;;
    -*)
      echo "Error: unknown option '$cmd'." >&2
      exit 1
      ;;
    *)
      cmd_switch "$cmd" "${2:-}"
      ;;
  esac
}

main "$@"
